##======================================================================
## Main Demo Runner
##======================================================================

_method object.run_all_demos()
    ## Runs all available demonstrations
    ## Shows the full capabilities of Magik programming
    ## 
    ## @return _unset
    
    write("")
    write("╔══════════════════════════════════════════════════════════════════╗")
    write("║                                                                  ║")
    write("║         SMALLWORLD MAGIK PROGRAMMING DEMONSTRATIONS              ║")
    write("║                                                                  ║")
    write("║     Generated by GitHub Copilot AI Assistant                     ║")
    write("║                                                                  ║")
    write("╚══════════════════════════════════════════════════════════════════╝")
    write("")
    write("This demonstration showcases various Magik programming concepts:")
    write("")
    write("  1. Hello World and Basic Output")
    write("  2. Variables and Data Types")
    write("  3. Control Flow (Conditionals and Loops)")
    write("  4. Procedures (Functions/Methods)")
    write("  5. Object-Oriented Programming")
    write("  6. Collections (Vectors, Hash Tables, Sets)")
    write("  7. Exception Handling")
    write("  8. Practical Examples (Geometry, Strings, Math)")
    write("")
    write("========================================")
    write("  Starting Demonstrations...")
    write("========================================")
    write("")
    
    # Run each demo section
    _self.demo_output()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_variables()
    write("")
    _self.demo_data_types()
    write("")
    _self.demo_arithmetic()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_conditionals()
    write("")
    _self.demo_loops()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_procedures()
    write("")
    _self.demo_iterators()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_oop()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_collections()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_exceptions()
    write("")
    write("----------------------------------------")
    write("")
    
    _self.demo_practical_examples()
    write("")
    
    write("╔══════════════════════════════════════════════════════════════════╗")
    write("║                                                                  ║")
    write("║         ALL DEMONSTRATIONS COMPLETED SUCCESSFULLY!               ║")
    write("║                                                                  ║")
    write("╚══════════════════════════════════════════════════════════════════╝")
    write("")
    
    _return _unset
_endmethod
$

##======================================================================
## Quick Demo - A shorter demonstration
##======================================================================

_method object.quick_demo()
    ## Runs a quick demonstration of key Magik features
    ## 
    ## @return _unset
    
    write("")
    write("=== Quick Magik Demo ===")
    write("")
    
    # 1. Basic output
    write("Hello, World!")
    write("")
    
    # 2. Variables
    _local message << "Magik is powerful!"
    _local number << 42
    _local pi << 3.14159
    write("Message: ", message)
    write("Number: ", number)
    write("Pi: ", pi)
    write("")
    
    # 3. Collections
    _local fruits << {"apple", "banana", "cherry"}
    write("Fruits: ", fruits)
    _for fruit _over fruits.fast_elements()
    _loop
        write("  - ", fruit)
    _endloop
    write("")
    
    # 4. Conditionals
    _if number > 40
    _then
        write("Number is greater than 40")
    _else
        write("Number is 40 or less")
    _endif
    write("")
    
    # 5. Arithmetic
    write("5 + 3 = ", 5 + 3)
    write("10 * 7 = ", 10 * 7)
    write("100 / 4 = ", 100 / 4)
    write("")
    
    # 6. Using a lambda
    _local square << _proc(x) >> x * x _endproc
    write("Square of 9: ", square.invoke(9))
    write("")
    
    # 7. Hash table
    _local person << hash_table.new()
    person[:name] << "Alice"
    person[:age] << 30
    write("Person: ", person[:name], ", age ", person[:age])
    write("")
    
    write("=== Quick Demo Complete ===")
    
    _return _unset
_endmethod
$

##======================================================================
## GIS-Specific Demo (Smallworld focus)
##======================================================================

_method object.gis_concepts_demo()
    ## Demonstrates GIS-related concepts that are common in Smallworld
    ## 
    ## @return _unset
    
    write("")
    write("=== GIS/Smallworld Concepts Demo ===")
    write("")
    
    # Coordinate handling
    write("Coordinate Handling:")
    _local lat << 51.5074
    _local lon << -0.1278
    write("  London coordinates: ", lat, "N, ", lon.abs, "W")
    write("")
    
    # Bounding box concept
    write("Bounding Box Example:")
    _local min_x << 100.0
    _local min_y << 200.0
    _local max_x << 300.0
    _local max_y << 400.0
    write("  Min corner: (", min_x, ", ", min_y, ")")
    write("  Max corner: (", max_x, ", ", max_y, ")")
    write("  Width: ", max_x - min_x)
    write("  Height: ", max_y - min_y)
    write("  Area: ", (max_x - min_x) * (max_y - min_y))
    write("")
    
    # Simple geometry operations
    write("Geometry Operations:")
    
    # Line length calculation
    _local line_coords << {{0, 0}, {3, 4}, {6, 4}}
    _local total_length << 0.0
    _for i _over range(1, line_coords.size - 1)
    _loop
        _local p1 << line_coords[i]
        _local p2 << line_coords[i + 1]
        _local dx << p2[1] - p1[1]
        _local dy << p2[2] - p1[2]
        _local segment_length << (dx ** 2 + dy ** 2).sqrt
        total_length << total_length + segment_length
        write("  Segment ", i, " length: ", segment_length)
    _endloop
    write("  Total line length: ", total_length)
    write("")
    
    # Centroid calculation
    write("Centroid Calculation:")
    _local polygon << {{0, 0}, {10, 0}, {10, 10}, {0, 10}}
    _local sum_x << 0.0
    _local sum_y << 0.0
    _for vertex _over polygon.fast_elements()
    _loop
        sum_x << sum_x + vertex[1]
        sum_y << sum_y + vertex[2]
    _endloop
    _local centroid_x << sum_x / polygon.size
    _local centroid_y << sum_y / polygon.size
    write("  Polygon vertices: ", polygon)
    write("  Centroid: (", centroid_x, ", ", centroid_y, ")")
    write("")
    
    # Attribute handling (typical in GIS)
    write("Feature Attributes (GIS Style):")
    _local feature << hash_table.new()
    feature[:id] << 12345
    feature[:type] << :road
    feature[:name] << "Main Street"
    feature[:length_m] << 1500.5
    feature[:lanes] << 4
    feature[:speed_limit] << 50
    
    _for attr, value _over feature.fast_keys_and_elements()
    _loop
        write("  ", attr, ": ", value)
    _endloop
    write("")
    
    write("=== GIS Concepts Demo Complete ===")
    
    _return _unset
_endmethod
$

##======================================================================
## Help method
##======================================================================

_method object.magik_help()
    ## Displays help information about available demos
    ## 
    ## @return _unset
    
    write("")
    write("╔══════════════════════════════════════════════════════════════════╗")
    write("║                   MAGIK DEMO HELP                                ║")
    write("╚══════════════════════════════════════════════════════════════════╝")
    write("")
    write("Available demo methods:")
    write("")
    write("  run_all_demos()      - Run all demonstrations (comprehensive)")
    write("  quick_demo()         - Run a quick overview of Magik features")
    write("  gis_concepts_demo()  - Demonstrate GIS/Smallworld concepts")
    write("")
    write("Individual topic demos:")
    write("")
    write("  demo_output()        - Basic output methods")
    write("  demo_variables()     - Variable declarations")
    write("  demo_data_types()    - Magik data types")
    write("  demo_arithmetic()    - Arithmetic operations")
    write("  demo_conditionals()  - If-then-else statements")
    write("  demo_loops()         - Loop constructs")
    write("  demo_procedures()    - Procedures and lambdas")
    write("  demo_oop()           - Object-oriented programming")
    write("  demo_collections()   - Collections (vectors, hash tables)")
    write("  demo_exceptions()    - Exception handling")
    write("  demo_geometry()      - Geometry utilities")
    write("  demo_string_utils()  - String manipulation")
    write("  demo_validation()    - Data validation")
    write("  demo_math()          - Math utilities")
    write("")
    write("Usage: Simply call any method on 'object', e.g.:")
    write("  object.quick_demo()")
    write("  object.run_all_demos()")
    write("")
    
    _return _unset
_endmethod
$
